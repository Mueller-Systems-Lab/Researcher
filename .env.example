# =============================================================================
# Researcher — Umgebungskonfiguration (.env.example)
# =============================================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# WARNUNG: .env NIEMALS committen (steht in .gitignore)!
#
# GPT Researcher v0.14.8 — Environment-Variablen (offizielles Format)
# Siehe: https://docs.gptr.dev/docs/gpt-researcher/llms
# =============================================================================

# ---------------------------------------------------------------------------
# LLM (Large Language Model) — via Ollama
# ---------------------------------------------------------------------------
# Format: <provider>:<model_name>
# Provider aktuell nur "ollama" (OpenAI-kompatible API via Ollama)
FAST_LLM=ollama:qwen3.5-9b-uncensored-hauhaucs-aggressive:latest
SMART_LLM=ollama:qwen3.5-9b-uncensored-hauhaucs-aggressive:latest
STRATEGIC_LLM=ollama:qwen3.5-9b-uncensored-hauhaucs-aggressive:latest

# Basis-URL des lokalen Ollama-Servers
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Inference-Backend (ADR-014/AC-6)
# ---------------------------------------------------------------------------
# "ollama" für Ollama-Server (empfohlen)
# "llama-server" für direkten llama.cpp-Server (via serve_qwen3.5_uncensored.sh)
INFERENCE_BACKEND=ollama

# ---------------------------------------------------------------------------
# Embedding — via Ollama (CPU, kein GPU-VRAM)
# ---------------------------------------------------------------------------
# Format: <provider>:<model_name>
# nomic-embed-text läuft auf CPU, schont GPU-VRAM
EMBEDDING=ollama:nomic-embed-text:latest

# ---------------------------------------------------------------------------
# Web-Suche via SearXNG
# ---------------------------------------------------------------------------
# Retriever-Modus:
#   "searx"  = eingebauter SearXNG-Retriever (für Basisbetrieb)
#   "custom" = eigener CompositeRetriever-Endpoint (SearXNG + Darknet)
#   Siehe T-007 für CompositeRetriever-Implementierung
RETRIEVER=searx

# Basis-URL des SearXNG-Docker-Containers (nur 127.0.0.1)
SEARX_URL=http://localhost:8080

# Maximale Trefferzahl pro SearXNG-Query
SEARX_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Darknet-Forum-Suche (für CompositeRetriever, siehe T-007)
# ---------------------------------------------------------------------------
DARKNET_ENABLED=false

# Pfad zum Suchindex (Whoosh-Directory oder SQLite-Datei)
DARKNET_INDEX_PATH=./darknet_index

# Suchindex-Backend: "whoosh" (legacy) oder "sqlite_fts5" (Migration, siehe ADR-013)
SEARCH_INDEX_BACKEND=whoosh

# ---------------------------------------------------------------------------
# Vektordatenbank (ChromaDB) — Wissensspeicher
# ---------------------------------------------------------------------------
# Persistenzverzeichnis für ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Name der ChromaDB-Collection
CHROMA_COLLECTION=gpt_researcher

# ---------------------------------------------------------------------------
# Dashboard (Server)
# ---------------------------------------------------------------------------
# Erlaubte CORS-Origins (kommagetrennt)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ---------------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------------
# Setze auf "true" um Cloud-Provider (OpenAI, Tavily) explizit zu erlauben.
# Ohne dieses Flag wird der Startup mit Cloud-Providern abgebrochen.
# ALLOW_CLOUD=true

# ---------------------------------------------------------------------------
# Forschungseinstellungen
# ---------------------------------------------------------------------------
# Maximale Suchergebnisse pro Subtopic-Query
MAX_SEARCH_RESULTS_PER_QUERY=15

# Maximale Anzahl Subtopics
MAX_SUBTOPICS=3

# Report-Quelle: "web" (Browser) oder "pdf"
REPORT_SOURCE=web

# Deterministischer Modus
# true  → temperature=0, reproduzierbare Ergebnisse, fixierte Seeds
# false → normale Parameter (empfohlen für Exploration)
RESEARCH_DETERMINISTIC=false

# ---------------------------------------------------------------------------
# VRAM-Optimierung (GTX 1070 / 8 GB)
# ---------------------------------------------------------------------------
# Nur 1 gleichzeitige LLM-Anfrage
MAX_CONCURRENT_REQUESTS=1
OLLAMA_NUM_PARALLEL=1

# Ollama Chat Model (Text Generation/Summary)
# MUSS ein Chat-/Summary-Modell sein, KEIN Embedding-Modell!
# Siehe docs/llm/model-selection-policy.md
OLLAMA_CHAT_MODEL=qwen3.5-uncensored-no-thinking:latest

# Ollama Embedding Model (Vector Search, CPU-seitig)
# Siehe docs/llm/model-selection-policy.md
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Ollama Model Fallback erlauben (true/1/yes)
# Wenn gesetzt: anderes Chat-Modell als Fallback nutzen, falls OLLAMA_CHAT_MODEL fehlt
# Embedding-Modelle werden NIE als Chat-Fallback gewählt
# ALLOW_OLLAMA_MODEL_FALLBACK=true
