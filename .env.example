# =============================================================================
# Researcher — Umgebungskonfiguration (.env.example)
# =============================================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# WARNUNG: .env NIEMALS committen (steht in .gitignore)!
#
# Generiert aus: blueprint.md Abschnitt 5 + Spezifikation CFG-001
# =============================================================================

# ---------------------------------------------------------------------------
# LLM (Large Language Model) — via Ollama
# ---------------------------------------------------------------------------
# Provider für Textgenerierung. Aktuell nur "ollama" unterstützt.
LLM_PROVIDER=ollama

# Basis-URL des Ollama-Servers (lokal, kein externer Zugriff nötig)
OLLAMA_BASE_URL=http://localhost:11434

# Modellname wie in Ollama registriert (siehe T-002)
LLM_MODEL=qwen3-8b-uncensored:latest

# ---------------------------------------------------------------------------
# Web-Suche via SearXNG
# ---------------------------------------------------------------------------
# Retriever-Typ: "custom" für CompositeRetriever (SearXNG + Darknet)
# Alternativ: "searx" nur für SearXNG (fallback)
RETRIEVER=custom

# Basis-URL des SearXNG-Docker-Containers (nur an 127.0.0.1 gebunden)
SEARX_URL=http://localhost:8080

# Maximale Anzahl Suchergebnisse pro SearXNG-Query
SEARX_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Darknet-Forum-Suche
# ---------------------------------------------------------------------------
# Aktiviert/Deaktiviert die Darknet-Suche im CompositeRetriever
DARKNET_ENABLED=true

# Pfad zum Whoosh-Volltextindex (wird vom Crawler befüllt)
DARKNET_INDEX_PATH=./darknet_index

# ---------------------------------------------------------------------------
# Embedding & Vektordatenbank (ChromaDB)
# ---------------------------------------------------------------------------
# Embedding-Provider: "ollama" verwendet nomic-embed-text über Ollama
EMBEDDING_PROVIDER=ollama

# Embedding-Modellname in Ollama (CPU-basiert, kein GPU-VRAM-Verbrauch)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Persistenzverzeichnis für ChromaDB (Vektordatenbank)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Name der ChromaDB-Collection (wird automatisch angelegt)
CHROMA_COLLECTION=gpt_researcher

# Batch-Größe für Embedding-Berechnungen (klein halten für CPU)
EMBEDDING_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# Forschungseinstellungen
# ---------------------------------------------------------------------------
# Maximale Suchergebnisse pro Subtopic-Query (Gesamtergebnisse)
MAX_SEARCH_RESULTS_PER_QUERY=15

# Maximale Anzahl Subtopics, in die eine Query zerlegt wird
MAX_SUBTOPICS=3

# Quelle für den finalen Report: "web" (Browser) oder "pdf"
REPORT_SOURCE=web

# ---------------------------------------------------------------------------
# VRAM-Optimierung (GTX 1070 / 8 GB)
# ---------------------------------------------------------------------------
# Maximale gleichzeitige LLM-Anfragen (1 = keine Parallelisierung)
MAX_CONCURRENT_REQUESTS=1

# Ollama-interne Parallelisierung deaktivieren (nur 1 Request gleichzeitig)
OLLAMA_NUM_PARALLEL=1
