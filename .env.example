# =============================================================================
# Researcher — Umgebungskonfiguration (.env.example)
# =============================================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# WARNUNG: .env NIEMALS committen (steht in .gitignore)!
#
# GPT Researcher v0.14.8 — Environment-Variablen (offizielles Format)
# Siehe: https://docs.gptr.dev/docs/gpt-researcher/llms
# =============================================================================

# ---------------------------------------------------------------------------
# LLM (Large Language Model) — via lokalen OpenAI-kompatiblen llama-server
# ---------------------------------------------------------------------------
# Format: <provider>:<model_name>
# Provider: "openai" für lokale OpenAI-kompatible Endpoints (llama-server)
#          "ollama" für Ollama (nur Embeddings empfohlen)
FAST_LLM=openai:qwen3.5-uncensored
SMART_LLM=openai:qwen3.5-uncensored
STRATEGIC_LLM=openai:qwen3.5-uncensored

# Basis-URL des OpenAI-kompatiblen llama-Servers
# Qwen3.5 Uncensored: http://127.0.0.1:8082/v1
OPENAI_BASE_URL=http://127.0.0.1:8082/v1

# API-Key für lokalen OpenAI-kompatiblen Server (Dummy-Wert, wird ignoriert)
OPENAI_API_KEY=not-needed

# Basis-URL des lokalen Ollama-Servers (nur für Embeddings)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Inference-Backend (ADR-014/AC-6)
# ---------------------------------------------------------------------------
# "llama-server" für direkten llama.cpp-Server (via research-serve.sh)
# "ollama" für Ollama-Server (nur für Embeddings, Chat crasht bei CUDA13+Pascal)
INFERENCE_BACKEND=llama-server

# ---------------------------------------------------------------------------
# Embedding — via Ollama (CPU, kein GPU-VRAM)
# ---------------------------------------------------------------------------
# Format: <provider>:<model_name>
# nomic-embed-text läuft auf CPU, schont GPU-VRAM
EMBEDDING=ollama:nomic-embed-text:latest

# ---------------------------------------------------------------------------
# Web-Suche via SearXNG
# ---------------------------------------------------------------------------
# Retriever-Modus:
#   "searx"  = eingebauter SearXNG-Retriever (für Basisbetrieb)
#   "custom" = eigener CompositeRetriever-Endpoint (SearXNG + Darknet)
#   Siehe T-007 für CompositeRetriever-Implementierung
RETRIEVER=searx

# Basis-URL des SearXNG-Docker-Containers (nur 127.0.0.1)
SEARX_URL=http://localhost:8080

# Maximale Trefferzahl pro SearXNG-Query
SEARX_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Darknet-Forum-Suche (für CompositeRetriever, siehe T-007)
# ---------------------------------------------------------------------------
DARKNET_ENABLED=false

# Pfad zum Suchindex (Whoosh-Directory oder SQLite-Datei)
DARKNET_INDEX_PATH=./darknet_index

# Suchindex-Backend: "whoosh" (legacy) oder "sqlite_fts5" (Migration, siehe ADR-013)
SEARCH_INDEX_BACKEND=whoosh

# ---------------------------------------------------------------------------
# Vektordatenbank (ChromaDB) — Wissensspeicher
# ---------------------------------------------------------------------------
# Persistenzverzeichnis für ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Name der ChromaDB-Collection
CHROMA_COLLECTION=gpt_researcher

# ---------------------------------------------------------------------------
# Dashboard (Server)
# ---------------------------------------------------------------------------
# Erlaubte CORS-Origins (kommagetrennt)
ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# ---------------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------------
# Setze auf "true" um Cloud-Provider (OpenAI, Tavily) explizit zu erlauben.
# Ohne dieses Flag wird der Startup mit Cloud-Providern abgebrochen.
# ALLOW_CLOUD=true

# ---------------------------------------------------------------------------
# Forschungseinstellungen
# ---------------------------------------------------------------------------
# Maximale Suchergebnisse pro Subtopic-Query
MAX_SEARCH_RESULTS_PER_QUERY=15

# Maximale Anzahl Subtopics
MAX_SUBTOPICS=3

# Report-Quelle: "web" (Browser) oder "pdf"
REPORT_SOURCE=web

# Deterministischer Modus
# true  → temperature=0, reproduzierbare Ergebnisse, fixierte Seeds
# false → normale Parameter (empfohlen für Exploration)
RESEARCH_DETERMINISTIC=false

# ---------------------------------------------------------------------------
# VRAM-Optimierung (GTX 1070 / 8 GB)
# ---------------------------------------------------------------------------
# Nur 1 gleichzeitige LLM-Anfrage
MAX_CONCURRENT_REQUESTS=1
OLLAMA_NUM_PARALLEL=1

# Ollama Chat Model (Text Generation/Summary) — Fallback-Pfad
# MUSS ein Chat-/Summary-Modell sein, KEIN Embedding-Modell!
# Das primäre Chat-Modell ist qwen3.5-uncensored via llama-server (FAST_LLM=openai:qwen3.5-uncensored).
# OLLAMA_CHAT_MODEL wird nur genutzt, wenn der INFERENCE_BACKEND=ollama ist oder research_planner darauf zugreift.
# Siehe docs/llm/model-selection-policy.md
OLLAMA_CHAT_MODEL=qwen3.5:9b

# Ollama Embedding Model (Vector Search, CPU-seitig)
# Siehe docs/llm/model-selection-policy.md
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Ollama Model Fallback erlauben (true/1/yes)
# Wenn gesetzt: anderes Chat-Modell als Fallback nutzen, falls OLLAMA_CHAT_MODEL fehlt
# Embedding-Modelle werden NIE als Chat-Fallback gewählt
# ALLOW_OLLAMA_MODEL_FALLBACK=true
LANGUAGE=german    # Berichtssprache (english, german, french, etc.)

# ---------------------------------------------------------------------------
# Crawler-Konfiguration (Darknet-Forum)
# ---------------------------------------------------------------------------
TOR_HOST=127.0.0.1
TOR_PORT=9050
FORUM_BASE_URL=
LOGIN_URL=
FORUM_USERNAME=
FORUM_PASSWORD=
CRAWL_MAX_PAGES=5
CRAWL_DELAY=5.0
CRAWL_MAX_POSTS=50

# ---------------------------------------------------------------------------
# Deep Research Services (zentral via config/services.py)
# ---------------------------------------------------------------------------
# Überschreibt die standard localhost-URLs für alle Dienste.
# Wenn nicht gesetzt, werden die Defaults aus config/services.py verwendet.
# SEARXNG_URL=http://localhost:8080
# LLAMA_SERVER_URL=http://127.0.0.1:8082/v1
# TOR_PROXY=socks5h://127.0.0.1:9050

# Deep Research Report-Verzeichnis
DEEP_REPORT_DIR=reports/deep_research

# ---------------------------------------------------------------------------
# Onion Discovery
# ---------------------------------------------------------------------------
ONION_DISCOVERY_ENABLED=false
ONION_SEED_FILE=./onion_seeds.json
ONION_REVIEW_FILE=./onion_review_queue.json

# ---------------------------------------------------------------------------
# Audit/Logging
# ---------------------------------------------------------------------------
AUDIT_LOG_FILE=./audit_trail.jsonl
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ---------------------------------------------------------------------------
# Service Ports (zentral via config/services.py)
# ---------------------------------------------------------------------------
# DASHBOARD_PORT=8888
# MCP_PORT=8765
# SEARXNG_TIMEOUT=30
# OLLAMA_TIMEOUT=30
# TOR_TIMEOUT=10
