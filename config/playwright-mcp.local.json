{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true
    },
    "contextOptions": {
      "baseURL": "http://127.0.0.1:8000"
    }
  },
  "capabilities": ["core", "testing"],
  "network": {
    "allowedOrigins": [
      "http://127.0.0.1:8000",
      "http://localhost:8000",
      "http://127.0.0.1:3000",
      "http://localhost:3000",
      "http://127.0.0.1:8888",
      "http://localhost:8888"
    ]
  }
}
