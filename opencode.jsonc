{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/security/security-gate-policy.md",
    "docs/development/local-runbook.md"
  ],
  "mcp": {
    // Repo-local MCP server exposing the security-gated tools in mcp_tools/.
    "researcher-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:8766/mcp",
      "enabled": true
    },
    // Ambient workspace gptr-mcp is disabled here to avoid cross-project bleed.
    "gptr-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:50000/sse",
      "enabled": false
    },
    // Project-scoped Playwright override: headless and restricted to local app origins.
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--config",
        "{env:WORKSPACE_ROOT}config/playwright-mcp.local.json"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
